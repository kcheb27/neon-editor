{
  "name": "neon-editor",
  "version": "0.1.0",
  "description": "A code editor with shared multi-window workspaces, a cwd-following terminal file tree and a vivid dark theme",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --test-force-exit --test-timeout=120000 \"test/**/*.test.ts\"",
    "smoke": "electron-vite build && node test/run-smoke.cjs",
    "package:win": "electron-vite build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "marked": "^16.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lib0": "^0.2.120",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "build": {
    "appId": "com.neoneditor.app",
    "productName": "neon-editor",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "splashImage": "build/splash.bmp"
    }
  }
}
